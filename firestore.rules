rules_version = '2';

// Bull Dashboard — Firestore security rules.
//
// `boards` and `clients` are readable/writable by anyone with the app's shared password
// (enforced only in the UI, not here — matches how it's always worked).
service cloud.firestore {
  match /databases/{database}/documents {

    match /boards/{boardId} {
      allow read, write: if true;
    }

    match /clients/{sheetId} {
      allow read, write: if true;
    }
  }
}
